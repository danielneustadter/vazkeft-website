---
import BaseLayout from '../layouts/BaseLayout.astro';
import { capabilities } from '../data/capabilities';

const doctrine = [
  {
    num: '01',
    title: 'Offense informs defense',
    body: 'Every defensive recommendation we make is grounded in vulnerabilities we have personally found and exploitation we have personally performed. We defend against what works, not what is marketed.',
  },
  {
    num: '02',
    title: 'Evidence over theater',
    body: 'No severity-score hand-waving, no compliance box-checking dressed up as security. Findings ship with proof, root cause, and a fix — or they do not ship.',
  },
  {
    num: '03',
    title: 'Engineering, not resale',
    body: 'We are not a reseller with a services arm. We build harnesses, detections, and pipelines from first principles, and everything we build in your environment belongs to you.',
  },
  {
    num: '04',
    title: 'Small team, deep bench',
    body: 'Vazkeft stays deliberately small. The researcher who scopes your engagement is the one who executes it — and the one who answers the phone afterward.',
  },
];
---

<BaseLayout
  title="Vazkeft LLC — Cybersecurity Research & Engineering"
  description="Vazkeft LLC is a cybersecurity research and engineering firm: vulnerability research, offensive security, managed cyber defense, and secure software delivery for defense and critical-infrastructure missions."
>
  <!-- ── HERO ─────────────────────────────────────────────── -->
  <section class="hero">
    <div class="grid-bg" aria-hidden="true"></div>

    <div class="container hero__inner">
      <div class="hero__icons" aria-hidden="true">
        <span class="hero__chip">
          <!-- shield -->
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M20 13c0 5-3.5 7.5-7.66 8.95a1 1 0 0 1-.67-.01C7.5 20.5 4 18 4 13V6a1 1 0 0 1 1-1c2 0 4.5-1.2 6.24-2.72a1.17 1.17 0 0 1 1.52 0C14.51 3.81 17 5 19 5a1 1 0 0 1 1 1z"/></svg>
        </span>
        <span class="hero__chip">
          <!-- bug -->
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="m8 2 1.88 1.88"/><path d="M14.12 3.88 16 2"/><path d="M9 7.13v-1a3.003 3.003 0 1 1 6 0v1"/><path d="M12 20c-3.3 0-6-2.7-6-6v-3a4 4 0 0 1 4-4h4a4 4 0 0 1 4 4v3c0 3.3-2.7 6-6 6"/><path d="M12 20v-9"/><path d="M6.53 9C4.6 8.8 3 7.1 3 5"/><path d="M6 13H2"/><path d="M3 21c0-2.1 1.7-3.9 3.8-4"/><path d="M20.97 5c0 2.1-1.6 3.8-3.5 4"/><path d="M22 13h-4"/><path d="M17.2 17c2.1.1 3.8 1.9 3.8 4"/></svg>
        </span>
        <span class="hero__chip">
          <!-- zap -->
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M4 14a1 1 0 0 1-.78-1.63l9.9-10.2a.5.5 0 0 1 .86.46l-1.92 6.02A1 1 0 0 0 13 10h7a1 1 0 0 1 .78 1.63l-9.9 10.2a.5.5 0 0 1-.86-.46l1.92-6.02A1 1 0 0 0 11 14z"/></svg>
        </span>
      </div>

      <h1 class="h-xl hero__title">Vazkeft LLC</h1>
      <p class="hero__sub">Cybersecurity Research &amp; Engineering</p>
      <p class="lede hero__lede">
        We hunt vulnerabilities the way adversaries do, defend networks with detections proven
        against live tradecraft, and build delivery pipelines that ship secure software to
        demanding missions.
      </p>
      <div class="hero__actions">
        <a href="/capabilities/" class="btn btn--solid">View capabilities</a>
        <a href="/contact/" class="btn btn--ghost">Get in touch</a>
      </div>
    </div>
  </section>

  <!-- ── POSITIONING ──────────────────────────────────────── -->
  <section class="section">
    <div class="container">
      <p class="eyebrow reveal">Who we are</p>
      <p class="bigstatement reveal">
        Founded as a vulnerability research firm, Vazkeft exists for one reason: the systems that
        national security and critical infrastructure depend on are attacked by professionals —
        and should be tested, defended, and built <em>by professionals who think the same way.</em>
      </p>
    </div>
  </section>

  <!-- ── CAPABILITIES ─────────────────────────────────────── -->
  <section class="section section--line">
    <div class="container">
      <div class="sechead reveal">
        <div>
          <p class="eyebrow">Capabilities</p>
          <h2 class="h-lg">Four disciplines.<br />One adversarial mindset.</h2>
        </div>
        <a href="/capabilities/" class="btn btn--ghost">All capabilities</a>
      </div>

      <div class="capgrid">
        {
          capabilities.map((cap) => (
            <a href={`/capabilities/${cap.slug}/`} class="capcard reveal">
              <p class="capcard__index">{cap.index}</p>
              <h3 class="h-md">{cap.name}</h3>
              <p class="capcard__body">{cap.short}</p>
              <p class="capcard__more">Learn more →</p>
            </a>
          ))
        }
      </div>
    </div>
  </section>

  <!-- ── DOCTRINE ─────────────────────────────────────────── -->
  <section class="section section--line">
    <div class="container">
      <p class="eyebrow reveal">How we operate</p>
      <h2 class="h-lg reveal">Principles we don’t trade away</h2>
      <div class="doctrine">
        {
          doctrine.map((d) => (
            <div class="doctrine__item reveal">
              <p class="doctrine__num">{d.num}</p>
              <h3 class="h-md">{d.title}</h3>
              <p>{d.body}</p>
            </div>
          ))
        }
      </div>
    </div>
  </section>

  <!-- ── MISSION STRIP ────────────────────────────────────── -->
  <section class="section section--line">
    <div class="container missionstrip__inner">
      <div class="reveal">
        <p class="eyebrow">Mission</p>
        <h2 class="h-lg">
          Built for the missions<br />that can’t fail quietly.
        </h2>
        <p class="lede" style="margin-top:1.2rem">
          From defense programs to the infrastructure civilians depend on, Vazkeft works where the
          cost of a breach is measured in more than money.
        </p>
        <a href="/mission/" class="btn btn--ghost" style="margin-top:2rem">Our mission</a>
      </div>
      <ul class="missionstrip__list reveal">
        <li>Vulnerability research &amp; reverse engineering</li>
        <li>Penetration testing &amp; adversary emulation</li>
        <li>Bug bounty operations</li>
        <li>Detection engineering &amp; managed defense</li>
        <li>CI/CD hardening &amp; supply-chain security</li>
      </ul>
    </div>
  </section>

  <!-- ── CTA ──────────────────────────────────────────────── -->
  <section class="section">
    <div class="container">
      <div class="ctapanel reveal">
        <div>
          <h2 class="h-lg">Put us on your problem.</h2>
          <p class="lede" style="margin-top:0.8rem">
            Engagements start with a conversation, not a contract. Tell us what you are protecting.
          </p>
        </div>
        <a href="/contact/" class="btn btn--solid">Start the conversation</a>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  /* hero */
  .hero {
    position: relative;
    overflow: hidden;
    border-bottom: 1px solid var(--line);
  }

  .hero__inner {
    position: relative;
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    padding-block: clamp(5.5rem, 13vw, 9.5rem);
  }

  .hero__icons {
    display: flex;
    gap: 1rem;
    margin-bottom: 2.2rem;
  }

  .hero__chip {
    display: grid;
    place-items: center;
    width: 3.4rem;
    height: 3.4rem;
    border-radius: 50%;
    background: rgba(229, 9, 20, 0.1);
    border: 1px solid rgba(229, 9, 20, 0.22);
    color: var(--accent-bright);
  }

  .hero__chip svg {
    width: 1.5rem;
    height: 1.5rem;
  }

  .hero__title {
    color: var(--accent);
  }

  .hero__sub {
    margin-top: 0.9rem;
    font-size: clamp(1.05rem, 2vw, 1.3rem);
    font-weight: 500;
    color: var(--text);
  }

  .hero__lede {
    margin-top: 1.3rem;
    max-width: 40rem;
  }

  .hero__actions {
    display: flex;
    gap: 1rem;
    margin-top: 2.6rem;
    flex-wrap: wrap;
    justify-content: center;
  }

  /* positioning statement */
  .bigstatement {
    font-family: var(--font-display);
    font-size: clamp(1.5rem, 3.2vw, 2.3rem);
    font-weight: 500;
    line-height: 1.35;
    max-width: 58rem;
    text-wrap: pretty;
  }

  .bigstatement em {
    font-style: normal;
    color: var(--accent-bright);
  }

  /* section head with side button */
  .sechead {
    display: flex;
    justify-content: space-between;
    align-items: flex-end;
    gap: 2rem;
    margin-bottom: 3rem;
    flex-wrap: wrap;
  }

  /* capability cards */
  .capgrid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 1.25rem;
  }

  .capcard {
    display: block;
    background: var(--panel);
    border: 1px solid var(--line);
    border-radius: var(--radius);
    padding: 2rem;
    transition: border-color 0.2s ease, background 0.2s ease, transform 0.2s ease;
  }

  .capcard:hover {
    border-color: var(--accent-dim);
    background: var(--panel-2);
    transform: translateY(-3px);
  }

  .capcard__index {
    font-size: 0.8rem;
    font-weight: 600;
    color: var(--accent-bright);
    letter-spacing: 0.1em;
    margin-bottom: 1.2rem;
  }

  .capcard__body {
    color: var(--text-dim);
    font-size: 0.95rem;
    margin-top: 0.8rem;
    min-height: 4.5rem;
  }

  .capcard__more {
    font-size: 0.88rem;
    font-weight: 500;
    color: var(--muted);
    margin-top: 1.5rem;
    transition: color 0.2s ease;
  }

  .capcard:hover .capcard__more {
    color: var(--accent-bright);
  }

  /* doctrine */
  .doctrine {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 2.5rem 3rem;
    margin-top: 3rem;
  }

  .doctrine__item p:last-child {
    color: var(--text-dim);
    font-size: 0.95rem;
    margin-top: 0.6rem;
  }

  .doctrine__num {
    font-size: 0.8rem;
    font-weight: 600;
    color: var(--accent-bright);
    letter-spacing: 0.1em;
    margin-bottom: 0.7rem;
  }

  /* mission strip */
  .missionstrip__inner {
    display: grid;
    grid-template-columns: 1.1fr 1fr;
    gap: 3rem;
    align-items: center;
  }

  .missionstrip__list {
    list-style: none;
    display: grid;
    gap: 0;
    background: var(--panel);
    border: 1px solid var(--line);
    border-radius: var(--radius);
    padding: 0.75rem 1.75rem;
  }

  .missionstrip__list li {
    padding-block: 1rem;
    color: var(--text-dim);
    display: flex;
    align-items: center;
    gap: 0.85rem;
  }

  .missionstrip__list li + li {
    border-top: 1px solid var(--line);
  }

  .missionstrip__list li::before {
    content: '';
    flex: none;
    width: 7px;
    height: 7px;
    border-radius: 50%;
    background: var(--accent);
  }

  /* cta */
  .ctapanel {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 2rem;
    flex-wrap: wrap;
    background: linear-gradient(135deg, var(--panel) 0%, #1c0e10 100%);
    border: 1px solid var(--accent-dim);
    border-radius: var(--radius);
    padding: clamp(2rem, 5vw, 3.5rem);
  }

  @media (max-width: 900px) {
    .missionstrip__inner {
      grid-template-columns: 1fr;
    }

    .capgrid,
    .doctrine {
      grid-template-columns: 1fr;
    }
  }
</style>
