---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { capabilities } from '../../data/capabilities';
---

<BaseLayout
  title="Capabilities — Vazkeft LLC"
  description="Vazkeft capability areas: vulnerability research, offensive security, managed cyber defense, and secure software delivery."
>
  <section class="section pagehead">
    <div class="grid-bg" aria-hidden="true"></div>
    <div class="container" style="position:relative">
      <p class="eyebrow">Capabilities</p>
      <h1 class="h-xl">Capability areas</h1>
      <p class="lede" style="margin-top:1.2rem">
        Four disciplines that reinforce each other: what we learn breaking systems drives how we
        defend them, and how we defend them drives how we build them.
      </p>
    </div>
  </section>

  <section class="container caplist">
    {
      capabilities.map((cap) => (
        <a href={`/capabilities/${cap.slug}/`} class="caprow ticks reveal">
          <p class="caprow__index">{cap.index}</p>
          <div class="caprow__main">
            <h2 class="h-md">{cap.name}</h2>
            <p>{cap.short}</p>
            <div class="caprow__readout">
              {cap.readout.map((r) => (
                <span>
                  <b>{r.label}</b> {r.value}
                </span>
              ))}
            </div>
          </div>
          <p class="caprow__arrow" aria-hidden="true">
            →
          </p>
        </a>
      ))
    }
  </section>
</BaseLayout>

<style>
  .pagehead {
    border-bottom: 1px solid var(--line);
    position: relative;
    overflow: hidden;
  }

  .caplist {
    display: grid;
    gap: 1.25rem;
    margin-top: 3rem;
  }

  .caprow {
    position: relative;
    display: grid;
    grid-template-columns: auto 1fr auto;
    gap: 2rem;
    align-items: center;
    background: var(--panel);
    border: 1px solid var(--line);
    border-radius: var(--radius);
    padding: 2rem;
    transition: border-color 0.2s ease, background 0.2s ease;
  }

  .caprow:hover {
    border-color: var(--accent-dim);
    background: var(--panel-2);
  }

  .caprow__index {
    font-size: 0.85rem;
    font-weight: 600;
    letter-spacing: 0.1em;
    color: var(--accent-bright);
  }

  .caprow__main p {
    color: var(--text-dim);
    font-size: 0.95rem;
    margin-top: 0.5rem;
    max-width: 46rem;
  }

  .caprow__readout {
    display: flex;
    flex-wrap: wrap;
    gap: 0.6rem 1.6rem;
    margin-top: 1.1rem;
  }

  .caprow__readout span {
    font-size: 0.8rem;
    color: var(--muted);
  }

  .caprow__readout b {
    color: var(--accent-bright);
    font-weight: 600;
    margin-right: 0.4rem;
  }

  .caprow__arrow {
    font-size: 1.4rem;
    color: var(--muted);
    transition: color 0.2s ease, transform 0.2s ease;
  }

  .caprow:hover .caprow__arrow {
    color: var(--accent-bright);
    transform: translateX(4px);
  }

  @media (max-width: 780px) {
    .caprow {
      grid-template-columns: 1fr;
      gap: 1rem;
    }

    .caprow__arrow {
      display: none;
    }
  }
</style>
