---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout
  title="404 — Vazkeft LLC"
  description="Page not found."
>
  <section class="section nf">
    <div class="grid-bg" aria-hidden="true"></div>
    <div class="container" style="position:relative">
      <p class="eyebrow">Error 404</p>
      <h1 class="h-xl">Page not found.</h1>
      <p class="lede" style="margin-top:1.2rem">
        The page you requested doesn’t exist — it may have moved, or the link may be out of date.
      </p>
      <a href="/" class="btn btn--solid" style="margin-top:2.4rem">Back to home</a>
    </div>
  </section>
</BaseLayout>

<style>
  .nf {
    position: relative;
    overflow: hidden;
    min-height: 60vh;
  }
</style>
